{
  "name": "hooktap",
  "version": "0.1.1",
  "description": "Local webhook capture, signature verification and replay for development",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "hooktap": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "precoverage": "npm run build",
    "dev": "npm run build && node dist/cli.js",
    "prepack": "npm run clean && npm run build",
    "pretest": "npm run build"
  },
  "keywords": [
    "webhook",
    "hmac",
    "signature",
    "testing",
    "localhost",
    "developer-tools"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
